# ECShopX offline release — runtime images & compose
# Copy to images.env and fill in the URLs / tags your team provides.
# After `docker load`, the IMAGE tags below must match the tags inside each tar.

# ---------------------------------------------------------------------------
# App base runtime (PHP/FPM etc.; NO MySQL/Redis)
# ---------------------------------------------------------------------------
# Optional: if empty and image is missing locally, deploy will `docker pull APP_BASE_IMAGE`.
APP_BASE_IMAGE_TAR_URL=
APP_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/shopex_company/ecshopex-php:ecx-8.2.29-fpm-alpine3.22-openresty-node-20.19

# Built application image name (compose build output)
APP_IMAGE=ecshopx:local

# ---------------------------------------------------------------------------
# MySQL / Redis — prefer offline tar (download URL → docker load)
# ---------------------------------------------------------------------------
MYSQL_IMAGE_TAR_URL=
MYSQL_IMAGE=mysql:5.7

REDIS_IMAGE_TAR_URL=
REDIS_IMAGE=redis:7.0

# ---------------------------------------------------------------------------
# Credentials / published ports (compose + app .env)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecshopx
MYSQL_USER=ecshopx
MYSQL_PASSWORD=ecshopx
REDIS_PASSWORD=redispassword

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
ADMIN_HOST_PORT=8080
H5_HOST_PORT=8081
PC_HOST_PORT=8082
# Relative API via PC nginx /api proxy — works for any host/IP.
NUXT_PUBLIC_API_BASE=/api/h5app
# Optional admin origins for decoration iframe postMessage (or set via deploy --admin-url).
NUXT_PUBLIC_DECORATION_ADMIN_ORIGINS=
