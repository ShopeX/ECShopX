# Same defaults as images.env.example — replace TAR URLs before customer deploy.
APP_BASE_IMAGE_TAR_URL=
APP_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/shopex_company/ecshopex-php:ecx-8.2.29-fpm-alpine3.22-openresty-node-20.19
APP_IMAGE=ecshopx:local

MYSQL_IMAGE_TAR_URL=https://shopex-onex-yundian-image.yuanyuanke.cn/ecshopx-doc/mysql-5.7.tar
MYSQL_IMAGE=mysql:5.7

REDIS_IMAGE_TAR_URL=https://shopex-onex-yundian-image.yuanyuanke.cn/ecshopx-doc/redis-7.0.tar
REDIS_IMAGE=redis:7.0

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ecshopx
MYSQL_USER=ecshopx
MYSQL_PASSWORD=ecshopx
REDIS_PASSWORD=redispassword

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
ADMIN_HOST_PORT=8080
H5_HOST_PORT=8081
PC_HOST_PORT=8082
# Relative API: browser calls same host:8082/api/... (nginx proxies to PHP). No IP/domain needed.
NUXT_PUBLIC_API_BASE=/api/h5app
# Optional: comma-separated admin origins for PC decoration postMessage.
# Leave empty and pass --admin-url to deploy.sh, or set e.g. http://localhost:8080
NUXT_PUBLIC_DECORATION_ADMIN_ORIGINS=
